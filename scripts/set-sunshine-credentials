#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Run "--save-credentials" against this checkout, before anything is installed.

A wrapper rather than a program: everything it would do lives in the package,
so that the same code runs here, from the installed copy, and on a platform
with no shell at all.
"""

import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from sunshine_apps_ui.__main__ import main  # noqa: E402

raise SystemExit(main(["--save-credentials"] + sys.argv[1:]))

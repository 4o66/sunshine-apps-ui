#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Capture Sunshine web-UI credentials for bazzite-sunshine-manager's --reload.
#
# Run this from your own terminal. The password is read without echo, never
# passed as an argument (argv is visible in ps and in shell history), and never
# printed back. It is verified against Sunshine before anything is written, so a
# typo fails here rather than silently later.
set -uo pipefail

CONF_DIR="${SUNSHINE_CONF_DIR:-$HOME/.config/sunshine}"
DEST="$CONF_DIR/.bsm-credentials"
CACERT="$CONF_DIR/credentials/cacert.pem"
URL="${SUNSHINE_URL:-https://127.0.0.1:47990}"

if [[ ! -f "$CACERT" ]]; then
  echo "No certificate at $CACERT -- is this the right config dir?" >&2
  exit 1
fi

printf 'Sunshine web UI username: '
IFS= read -r BSM_USER
printf 'Sunshine web UI password: '
IFS= read -rs BSM_PASS
printf '\n'
printf 'Confirm password: '
IFS= read -rs BSM_PASS2
printf '\n'

if [[ "$BSM_PASS" != "$BSM_PASS2" ]]; then
  echo "Passwords do not match; nothing written." >&2
  exit 1
fi
if [[ -z "$BSM_USER" || -z "$BSM_PASS" ]]; then
  echo "Username and password are both required; nothing written." >&2
  exit 1
fi

# Verify before saving. Values go in via the environment, not argv.
BSM_USER="$BSM_USER" BSM_PASS="$BSM_PASS" CACERT="$CACERT" URL="$URL" \
python3 - <<'PY'
import base64, os, ssl, sys, urllib.error, urllib.request
ctx = ssl.create_default_context(cafile=os.environ["CACERT"])
ctx.check_hostname = False          # CN is "Sunshine Gamestream Host", not a host
token = base64.b64encode(f"{os.environ['BSM_USER']}:{os.environ['BSM_PASS']}".encode()).decode()
req = urllib.request.Request(os.environ["URL"] + "/api/apps",
                             headers={"Authorization": "Basic " + token})
try:
    with urllib.request.urlopen(req, timeout=10, context=ctx) as r:
        r.read()
except urllib.error.HTTPError as e:
    sys.exit(2 if e.code in (401, 403) else 3)
except Exception:
    sys.exit(4)
PY
case $? in
  0) ;;
  2) echo "Sunshine rejected those credentials; nothing written." >&2; exit 1 ;;
  3) echo "Sunshine answered with an unexpected error; nothing written." >&2; exit 1 ;;
  4) echo "Could not reach or verify $URL; nothing written." >&2; exit 1 ;;
esac

umask 077
printf 'username=%s\npassword=%s\n' "$BSM_USER" "$BSM_PASS" > "$DEST"
chmod 600 "$DEST"
unset BSM_PASS BSM_PASS2

echo "Verified and saved to $DEST (mode $(stat -c %a "$DEST"))."
echo "Nothing was echoed and no value appears in your shell history."

#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Capture a SteamGridDB API key for the artwork picker.
#
# Run this from your own terminal. Get a key from
# https://www.steamgriddb.com/profile/preferences/api -- it is free, and it is
# what makes community artwork available for games Steam has no cover for.
#
# The key is read without echo and handed to the manager on stdin. Never as an
# argument: argv is visible in ps and lands in shell history, which is exactly
# what this script exists to avoid. It is checked against the API before being
# stored, so a bad paste fails here rather than looking, weeks later, like
# SteamGridDB simply having no artwork for anything.
set -uo pipefail

MANAGER="${MANAGER:-$HOME/.local/bin/sunshine-apps-ui}"
if [[ ! -x "$MANAGER" ]]; then
  MANAGER="$(command -v sunshine-apps-ui 2>/dev/null || true)"
fi
if [[ -z "$MANAGER" ]]; then
  echo "sunshine-apps-ui is not installed; run scripts/install first." >&2
  exit 1
fi

printf 'SteamGridDB API key: '
IFS= read -rs SGDB_KEY
printf '\n'

if [[ -z "$SGDB_KEY" ]]; then
  echo "No key given; nothing written." >&2
  exit 1
fi

# The last line is the verdict; anything before it is progress.
OUTPUT=$(printf '%s\n' "$SGDB_KEY" | "$MANAGER" --save-sgdb-key 2>&1 >/dev/null)
status=$?
unset SGDB_KEY

if (( status != 0 )); then
  echo "${OUTPUT##*$'\n'}" >&2
  echo "Nothing was written." >&2
  exit 1
fi
echo "${OUTPUT##*$'\n'}"
echo "Nothing was echoed and no value appears in your shell history."
